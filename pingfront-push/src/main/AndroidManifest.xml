<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Receives FCM tokens and pingfront data messages. Apps with their own FirebaseMessagingService
             remove this with tools:node="remove" and call PingFrontPush from theirs. -->
        <service
            android:name="dev.pingfront.push.PingFrontMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
